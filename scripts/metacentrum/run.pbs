#!/bin/bash
#PBS -l walltime=24:00:00
#PBS -j oe
# One `experiments run` on a CPU node: scores the systems of a run config with the
# models in the storage's resource root. Submitted by evaluate.sh, which passes
# STORE and CONFIG (qsub -v) and the resources (qsub -l select=...).
#
# GLiNER predicts on the CPU (detect/gliner.py loads it there), so the job needs
# no GPU. Predictions are cached in the storage, so a rerun or a later config
# naming the same models reads them instead of predicting again.
set -euo pipefail
source "$STORE/anonymizer/scripts/metacentrum/env.sh"

echo "job $PBS_JOBID on $(hostname -f): run $CONFIG"
cd "$REPO"
uv run --no-sync python -m experiments run --config "$CONFIG" \
    --resource-root "$ROOT" --cache-dir "$STORE/cache" --out "$RESULTS"
