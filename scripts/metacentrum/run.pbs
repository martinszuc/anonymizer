#!/bin/bash
#PBS -l walltime=4:00:00
#PBS -j oe
# One `experiments run` (or `errors`, with COMMAND=errors) on a GPU node: scores
# the systems of a run config with the models in the storage's resource root.
# Submitted by evaluate.sh, which passes STORE, CONFIG and COMMAND (qsub -v) and
# the resources (qsub -l select=...).
#
# GLiNER predicts on the GPU (--device cuda); NameTag 3 and everything after the
# models run on the CPU. Predictions are cached in the storage, per device, so a
# rerun or a later config naming the same models reads them instead of
# predicting again.
set -euo pipefail
source "$STORE/anonymizer/scripts/metacentrum/env.sh"

command=${COMMAND:-run}
echo "job $PBS_JOBID on $(hostname -f): $command $CONFIG"
nvidia-smi --query-gpu=name,memory.total,driver_version --format=csv
cd "$REPO"
uv run --no-sync python -m experiments "$command" --config "$CONFIG" --device cuda \
    --resource-root "$ROOT" --cache-dir "$STORE/cache" --out "$RESULTS"
